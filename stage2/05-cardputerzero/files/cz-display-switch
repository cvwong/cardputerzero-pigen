#!/bin/bash
# cz-display-switch — keep the console where it belongs.
# fbcon hands every VT to a newly registered vc4 HDMI fb (phantom HPD glitch
# or a real monitor), which blanks the 320x170 panel; re-pin tty1 to the panel
# on every hotplug event, and park tty2-6 on the HDMI fb when one exists so an
# external monitor gets its own getty terminal (getty@tty2, plain CLI because
# cz-autostart only launches the menu on tty1).
set -u
R=${CZ_DS_ROOT:-}
LOCK=${CZ_DS_LOCK:-/run/lock/cz-display-switch.lock}
mkdir -p "$(dirname "$LOCK")" 2>/dev/null
exec 9>"$LOCK" 2>/dev/null || exit 0
flock -n 9 || exit 0

log() { logger -t cz-display "$1" 2>/dev/null || echo "cz-display: $1"; }

panel_fb() {
    local d
    for d in "$R"/sys/class/graphics/fb[0-9]*; do
        [ -r "$d/virtual_size" ] || continue
        case "$(cat "$d/virtual_size")" in
            320,170|170,320) echo "${d##*/fb}"; return 0 ;;
        esac
    done
    return 1
}

hdmi_fb() {
    local d
    for d in "$R"/sys/class/graphics/fb[0-9]*; do
        [ "$(cat "$d/name" 2>/dev/null)" = vc4drmfb ] && { echo "${d##*/fb}"; return 0; }
    done
    return 1
}

map_vt() { con2fbmap "$1" "$2" 2>/dev/null || true; }

# Let a hotplug modeset finish before reading the framebuffer list.
sleep "${CZ_DS_SETTLE:-1}"

P=$(panel_fb) || P=""
H=$(hdmi_fb)  || H=""
if [ -z "$P" ]; then log "no panel framebuffer; nothing to do"; exit 0; fi

map_vt 1 "$P"
if [ -n "$H" ]; then
    for t in 2 3 4 5 6; do map_vt "$t" "$H"; done
else
    for t in 2 3 4 5 6; do map_vt "$t" "$P"; done
    # Unplug: the live console may sit on the vanished HDMI fb (its index now
    # points at the panel), leaving the menu stuck in background; bring it home.
    if [ "$(fgconsole 2>/dev/null)" != 1 ]; then chvt 1 2>/dev/null || true; fi
fi

# Wake the HDMI framebuffer. fbcon starts every console on fb0 (fbcon=map:0),
# then lcd-console moves tty1 to the panel, and nothing ever wakes the fb it left
# behind: a monitor attached after boot gets a black picture with the signal up,
# and switching to tty2 does not fix it. cz-splash's FBIOBLANK only ever targeted
# the panel. Verified on hardware 2026-11-27: writing 0 here brought the monitor
# up immediately.
#
# Do it on every run, before the state cache below can short-circuit, because a
# reattach with an unchanged fb layout still needs the wake. Note the `blank`
# attribute reads 4 again afterwards even while the monitor is displaying, so it
# is not a usable readout of whether this worked - only the picture is.
if [ -n "$H" ] && [ -w "$R/sys/class/graphics/fb$H/blank" ]; then
    echo 0 > "$R/sys/class/graphics/fb$H/blank" 2>/dev/null || true
fi

STATE=${CZ_DS_STATE:-/run/cz-display-switch.state}
cur="$P ${H:-none}"
if [ -r "$STATE" ] && [ "$(cat "$STATE" 2>/dev/null)" = "$cur" ]; then exit 0; fi
printf '%s\n' "$cur" > "$STATE" 2>/dev/null || true
if [ -n "$H" ]; then
    log "tty1 pinned to panel fb$P; tty2-6 on HDMI fb$H (monitor terminal)"
    # Boot console text rendered into the HDMI fb before the pin leaves a
    # stale garbled frame; black it out until the compositor takes the card.
    if [ -z "$R" ] && [ -w "/dev/fb$H" ]; then
        cat /dev/zero > "/dev/fb$H" 2>/dev/null || true
    fi
else
    log "tty1-6 on panel fb$P (no HDMI framebuffer)"
fi
