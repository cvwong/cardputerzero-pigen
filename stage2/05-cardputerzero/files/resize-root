#!/bin/bash
# Grow the root partition to the end of the disk, then the filesystem to match.
#
# This runs from userspace (cardputerzero-resize.service) rather than from the
# initramfs: the stock ` resize` cmdline token drives resize_early and
# set_partuuid before switch_root, and on this board that path never returned,
# so 02-run.sh drops the token at build time.
set -eu

# Overridable for the same reason cz-splash overrides SYSFS: the geometry below
# cannot otherwise be exercised on a machine whose root is not partition 2.
SYS=${CZ_RESIZE_SYS:-/sys}

ROOT_DEV=$(findmnt -n -o SOURCE /)
ROOT_PART_NAME=$(lsblk -no KNAME "$ROOT_DEV")
ROOT_DISK_NAME=$(lsblk -no PKNAME "$ROOT_DEV")
ROOT_DISK="/dev/$ROOT_DISK_NAME"
SYS_PART="$SYS/block/$ROOT_DISK_NAME/$ROOT_PART_NAME"
ROOT_PART_NUM=$(cat "$SYS_PART/partition")

if [ "$ROOT_PART_NUM" -ne 2 ]; then
    echo "cardputerzero-resize: unexpected partition layout (root is partition $ROOT_PART_NUM, expected 2), skipping"
    exit 0
fi

DISK_SIZE=$(cat "$SYS/block/$ROOT_DISK_NAME/size")
TARGET_END=$((DISK_SIZE - 1))
if [ "$TARGET_END" -gt 4294967295 ]; then
    TARGET_END=4294967295
fi

# A card that already booted once has the partition at the end of the disk with
# only the filesystem left to grow; re-running parted there is pointless.
PART_START=$(cat "$SYS_PART/start")
WANT_SIZE=$((TARGET_END - PART_START + 1))
HAVE_SIZE=$(cat "$SYS_PART/size")

if [ "$HAVE_SIZE" -ge "$WANT_SIZE" ]; then
    echo "cardputerzero-resize: partition already ends at sector $((PART_START + HAVE_SIZE - 1)), skipping parted"
else
    echo "cardputerzero-resize: expanding partition $ROOT_PART_NUM on $ROOT_DISK to sector $TARGET_END"
    parted -m "$ROOT_DISK" u s resizepart "$ROOT_PART_NUM" "$TARGET_END"

    # partprobe cannot re-read a disk whose partition is mounted and fails with
    # EBUSY; partx --update issues BLKPG_RESIZE_PARTITION, which the kernel
    # accepts for the live root.
    partx --update "$ROOT_DISK" 2>/dev/null || partprobe "$ROOT_DISK" 2>/dev/null || true
fi

# Fail loudly instead of reporting success with the filesystem still small: the
# kernel has to agree on the new size before resize2fs can grow into it.
HAVE_SIZE=$(cat "$SYS_PART/size")
if [ "$HAVE_SIZE" -lt "$WANT_SIZE" ]; then
    echo "cardputerzero-resize: kernel still reports $HAVE_SIZE sectors for $ROOT_PART_NAME, expected $WANT_SIZE - filesystem not grown" >&2
    exit 1
fi

echo "cardputerzero-resize: expanding filesystem on $ROOT_DEV"
resize2fs "$ROOT_DEV"

echo "cardputerzero-resize: done"
