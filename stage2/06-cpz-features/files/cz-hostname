#!/bin/bash
# cz-hostname — show or set hostname, keeping /etc/hosts in sync so sudo
# does not warn "unable to resolve host".
set -u
cur=$(hostnamectl --static 2>/dev/null || cat /etc/hostname)

if [ -z "${1:-}" ]; then
    printf 'current: %s\n' "$cur"
    printf 'new hostname (blank=cancel): '
    read -r new
    [ -n "$new" ] || exit 100
else
    new="$1"
fi

if ! [[ "$new" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]]; then
    echo "invalid: letters, digits, hyphens; no leading/trailing hyphen"
    exit 1
fi
if [ "$new" = "$cur" ]; then echo "already $new"; exit 0; fi

sudo hostnamectl set-hostname "$new" || exit 1

if grep -qE '^127\.0\.1\.1[[:space:]]' /etc/hosts; then
    sudo sed -i -E "s/^127\.0\.1\.1[[:space:]].*/127.0.1.1\t$new/" /etc/hosts
else
    printf '127.0.1.1\t%s\n' "$new" | sudo tee -a /etc/hosts >/dev/null
fi

echo "hostname: $cur -> $new"
echo "open a new shell to see it; reboot updates everything"
