#!/bin/bash
# cz-hostname — show or set hostname. /etc/hosts and the hostname are changed
# in ONE sudo invocation: two calls leave a window where sudo cannot resolve
# the machine's own name and warns on every subsequent call.
set -u
cur=$(hostnamectl --static 2>/dev/null || cat /etc/hostname)

if [ -z "${1:-}" ]; then
    printf 'current: %s\n' "$cur"
    printf 'new hostname (blank=cancel): '
    read -r new
    [ -n "$new" ] || exit 100
else
    new="$1"
fi

if ! [[ "$new" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]]; then
    echo "invalid: letters, digits, hyphens; no leading/trailing hyphen"
    exit 1
fi
if [ "$new" = "$cur" ]; then echo "already $new"; exit 0; fi

sudo sh -c '
    h="$1"
    if grep -qE "^127\.0\.1\.1[[:space:]]" /etc/hosts; then
        sed -i -E "s/^127\.0\.1\.1[[:space:]].*/127.0.1.1\t$h/" /etc/hosts
    else
        printf "127.0.1.1\t%s\n" "$h" >> /etc/hosts
    fi
    hostnamectl set-hostname "$h"
' _ "$new" || { echo "failed to set hostname"; exit 1; }

printf 'hostname: %s -> %s\n' "$cur" "$new"
grep -E '^127\.0\.1\.1' /etc/hosts
echo "open a new shell to see it"
