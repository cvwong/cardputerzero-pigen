#!/bin/bash
# cz-splash — image splash on the CardputerZero LCD before login.
FB=${CZ_SPLASH_FB:-/dev/fb0}
IMG=${CZ_SPLASH_IMG:-/usr/share/cz/cz-splash.rgb565}
PING=${CZ_SPLASH_PING:-/usr/share/cz/cz-ping.wav}
CZ_FONT=${CZ_FONT:-/usr/share/consolefonts/Lat15-Terminus12x6.psf.gz}
MIN_SHOW=${CZ_SPLASH_MIN:-3}
MAX_WAIT=${CZ_SPLASH_MAX:-15}

vtmode() {
  python3 -c 'import os,fcntl,sys
fd=os.open("/dev/tty1",os.O_RDWR)
fcntl.ioctl(fd,0x4B3A,1 if sys.argv[1]=="g" else 0)
os.close(fd)' "$1"
}
trap 'vtmode t; setfont -C /dev/tty1 "$CZ_FONT" 2>/dev/null' EXIT TERM INT

start=$(date +%s)

# Wait for the panel driver to register the framebuffer.
for _ in $(seq 1 100); do [ -w "$FB" ] && break; sleep 0.1; done
if [ ! -w "$FB" ]; then
    echo "cz-splash: $FB not writable after 10s - no image" >&2
else
    vtmode g
    cat "$IMG" > "$FB" || echo "cz-splash: blit failed rc=$?" >&2
fi

# Wait for the codec to actually enumerate, not just sound.target.
for _ in $(seq 1 100); do
    grep -q ES8389 /proc/asound/cards 2>/dev/null && break
    sleep 0.1
done
amixer -c ES8389Audio sset Speaker on  >/dev/null || echo "cz-splash: Speaker ctl failed" >&2
amixer -c ES8389Audio sset DACL 80%    >/dev/null
amixer -c ES8389Audio sset DACR 80%    >/dev/null
aplay -q "$PING" || echo "cz-splash: aplay rc=$? cards=$(tr '\n' ';' </proc/asound/cards)" >&2

while :; do
    el=$(( $(date +%s) - start ))
    [ "$el" -ge "$MAX_WAIT" ] && break
    if [ "$el" -ge "$MIN_SHOW" ] && systemctl is-active --quiet systemd-user-sessions.service; then
        break
    fi
    sleep 0.2
done
