#!/bin/bash
# cz-splash — image splash on the CardputerZero LCD before login.

# SYSFS is overridable for the same reason the other knobs are: the detection
# below cannot otherwise be exercised on a machine with no panel.
SYSFS=${CZ_SPLASH_SYSFS:-/sys/class/graphics}

# Resolve the framebuffer the LCD panel is actually on. lcd-console maps tty1 to
# the 320x170 panel, but which /dev/fbN that is depends on whether an HDMI output
# came up first: cmdline forces video=HDMI-A-1:1920x1080@60D, so with a monitor
# attached HDMI takes fb0 and the panel becomes fb1 (journal 2026-11-26:
# "lcd-console: tty1->fb1 (LCD), tty2-6->fb0 (HDMI)"). A hardcoded /dev/fb0 then
# blits the splash to the monitor and unblanks the monitor, leaving the panel
# powered down and the login screen dark. Detect it the way lcd-console does.
panel_fb() {
  local d n
  for d in "$SYSFS"/fb[0-9]*; do
    [ -r "$d/virtual_size" ] || continue
    case "$(cat "$d/virtual_size" 2>/dev/null)" in
      320,170|170,320) echo "/dev/${d##*/}"; return 0 ;;
    esac
  done
  # No panel matched: fall back to wherever tty1 is mapped (last number in
  # con2fbmap's output), then to fb0.
  n=$(con2fbmap 1 2>/dev/null | grep -oE '[0-9]+' | tail -1)
  if [ -n "$n" ] && [ -w "/dev/fb$n" ]; then echo "/dev/fb$n"; return 0; fi
  echo /dev/fb0
}

FB=${CZ_SPLASH_FB:-$(panel_fb)}
IMG=${CZ_SPLASH_IMG:-/usr/share/cz/cz-splash.rgb565}
PING=${CZ_SPLASH_PING:-/usr/share/cz/cz-ping.wav}
CZ_FONT=${CZ_FONT:-/usr/share/consolefonts/Lat15-Terminus12x6.psf.gz}
MIN_SHOW=${CZ_SPLASH_MIN:-3}
MAX_WAIT=${CZ_SPLASH_MAX:-15}

vtmode() {
  python3 -c 'import os,fcntl,sys
fd=os.open("/dev/tty1",os.O_RDWR)
fcntl.ioctl(fd,0x4B3A,1 if sys.argv[1]=="g" else 0)
os.close(fd)' "$1"
}

# Switching the VT to KD_GRAPHICS detaches fbcon, and the panel-mipi-dbid DRM
# driver then powers the panel down -- the panel's /sys/class/graphics/fbN/blank
# reads 4 (FB_BLANK_POWERDOWN) even though consoleblank=0 and lcd-console already
# ran `setterm --blank 0 --powerdown 0`. Restoring KD_TEXT does not power it back
# on, so the login banner agetty draws next goes into a dark panel and the device
# looks dead. Unblank explicitly via FBIOBLANK on the way out -- against $FB, the
# panel, which is not necessarily fb0.
unblank() {
  python3 -c 'import os,fcntl,sys
try:
    fd = os.open(sys.argv[1], os.O_RDWR)
    fcntl.ioctl(fd, 0x4611, 0)   # FBIOBLANK, VESA_NO_BLANKING
    os.close(fd)
except Exception:
    pass' "$FB" 2>/dev/null
}

# Log the panel device and its blank state either side of the unblank, so the
# journal shows which framebuffer was chosen and whether the graphics blit really
# is what powers it down, instead of leaving either a theory.
restore_console() {
  local b="$SYSFS/${FB##*/}/blank"
  vtmode t
  setfont -C /dev/tty1 "$CZ_FONT" 2>/dev/null
  echo "cz-splash: panel=$FB blank before unblank=$(cat "$b" 2>/dev/null)"
  unblank
  echo "cz-splash: blank after unblank=$(cat "$b" 2>/dev/null)"
}
trap restore_console EXIT TERM INT

start=$(date +%s)

# Wait for the panel driver to register the framebuffer.
for _ in $(seq 1 100); do [ -w "$FB" ] && break; sleep 0.1; done
if [ ! -w "$FB" ]; then
    echo "cz-splash: $FB not writable after 10s - no image" >&2
else
    vtmode g
    cat "$IMG" > "$FB" || echo "cz-splash: blit failed rc=$?" >&2
fi

# Wait for the codec to actually enumerate, not just sound.target.
for _ in $(seq 1 100); do
    grep -q ES8389 /proc/asound/cards 2>/dev/null && break
    sleep 0.1
done
amixer -c ES8389Audio sset Speaker on  >/dev/null || echo "cz-splash: Speaker ctl failed" >&2
amixer -c ES8389Audio sset DACL 80%    >/dev/null
amixer -c ES8389Audio sset DACR 80%    >/dev/null
aplay -q "$PING" || echo "cz-splash: aplay rc=$? cards=$(tr '\n' ';' </proc/asound/cards)" >&2

while :; do
    el=$(( $(date +%s) - start ))
    [ "$el" -ge "$MAX_WAIT" ] && break
    if [ "$el" -ge "$MIN_SHOW" ] && systemctl is-active --quiet systemd-user-sessions.service; then
        break
    fi
    sleep 0.2
done
