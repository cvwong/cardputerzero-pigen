[Unit]
Description=Give the login user write access to tty2 (monitor console)
After=cz-firstboot.service
Before=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'U=$(getent passwd 1000 | cut -d: -f1); [ -n "$U" ] && chown "$U" /dev/tty2 && chmod 600 /dev/tty2'

[Install]
WantedBy=multi-user.target
