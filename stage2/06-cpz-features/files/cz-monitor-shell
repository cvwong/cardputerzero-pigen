#!/bin/bash
# cz-monitor-shell — the monitor's pure CLI: a bare bash prompt on tty2,
# started by cz-autostart when the user logs in on the panel. No motd, no
# menu, no login prompt — just PS1. Input works when the monitor is the
# foreground console (Alt+M); otherwise the frame stays frozen on the fb.
set -u
TTY2=${CZ_MON_TTY2:-/dev/tty2}
[ -w "$TTY2" ] || exit 0
RC=/tmp/cz-monitor.rc.$$
printf 'PS1="\\u@\\h:\\w\\$ "\n' > "$RC" || exit 0
trap 'rm -f "$RC"' EXIT
printf '\e[2J\e[H' > "$TTY2"
exec bash --noprofile --rcfile "$RC" -i <"$TTY2" >"$TTY2" 2>&1
