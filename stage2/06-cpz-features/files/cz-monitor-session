#!/bin/bash
# cz-monitor-session — runs inside foot on the HDMI monitor.
# Shows Waiting until the user logs in on the panel, then a bare shell
# (prompt only). When the shell exits, hand the console back to the panel.
set -u
FLAG=${CZ_MON_FLAG:-/run/cz-panel-login}
if [ ! -e "$FLAG" ]; then
    printf '\e[2J\e[H\e[1mWaiting\e[0m\n'
    while [ ! -e "$FLAG" ]; do sleep 1; done
    printf '\e[2J\e[H'
fi
RC=/tmp/cz-monitor.rc.$$
printf 'PS1="\\u@\\h:\\w\\$ "\n' > "$RC" || exit 1
trap 'rm -f "$RC"' EXIT
bash --noprofile --rcfile "$RC" -i
cz-output panel 2>/dev/null || chvt 1 2>/dev/null || true
