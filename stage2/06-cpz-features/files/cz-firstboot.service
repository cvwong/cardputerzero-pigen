[Unit]
Description=CardputerZero first-boot account setup
ConditionPathExists=!/var/lib/cz/firstboot-done
After=cz-splash.service lcd-console.service
Before=getty@tty1.service

[Service]
Type=oneshot
RemainAfterExit=yes
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
ExecStart=/usr/local/bin/cz-firstboot
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
