#!/bin/sh
# 99-cz-issue — refresh the tty1 login banner once an address arrives.
#
# cz-issue runs from getty@tty1's ExecStartPre, which fires about 24s into boot
# while DHCP completes around 30s (measured on a CardputerZero, 2026-11-24). So the first
# banner of a boot would read "no address yet" and keep reading it: the address
# is baked into /etc/issue, and agetty only re-reads that file when it next
# starts. Blocking getty until DHCP finished would delay the login prompt by
# 6-8s on every boot, which is a worse trade on a handheld.
#
# So instead this regenerates the banner on connectivity change and repaints the
# prompt -- but only when the console is idle, because restarting getty@tty1
# would kill an active session.
#
# NetworkManager runs dispatcher scripts as root with $1=interface, $2=action.
# The file must be root-owned and not group/world writable, or NM ignores it.
set -u

CZ_ISSUE="${CZ_ISSUE_BIN:-/usr/local/sbin/cz-issue}"
GETTY="${CZ_ISSUE_GETTY:-getty@tty1.service}"
ISSUE_FILE="${CZ_ISSUE_FILE:-/etc/issue}"

case "${2:-}" in
    up|dhcp4-change|dhcp6-change|connectivity-change) ;;
    *) exit 0 ;;
esac

[ -x "$CZ_ISSUE" ] || exit 0

before=$(cat "$ISSUE_FILE" 2>/dev/null)
"$CZ_ISSUE" || exit 0
after=$(cat "$ISSUE_FILE" 2>/dev/null)

# Nothing changed (a second interface came up, or the address was already
# baked in): leave the prompt alone rather than flickering the screen.
[ "$before" = "$after" ] && exit 0

# Repaint only if nobody is on the console. `who` field 2 is the terminal, so an
# ssh session reports "sshd" or "pts/N" and never matches tty1.
if who 2>/dev/null | awk '$2 == "tty1" { found=1 } END { exit !found }'; then
    exit 0
fi

systemctl restart "$GETTY" 2>/dev/null || true
exit 0
