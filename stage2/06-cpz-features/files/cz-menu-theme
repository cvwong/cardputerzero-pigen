#!/bin/bash
# cz-menu-theme — themed control panel for CardputerZero (53x14 console); the default menu.
# Palette, box drawing, header/row helpers and the confirm dialog come from
# cz-theme.sh, which cz-record also sources, so the two cannot drift apart.
export JACK_NO_START_SERVER=1

CZ_THEME="${CZ_THEME:-/usr/local/lib/cz-theme.sh}"
[ -r "$CZ_THEME" ] || { echo "cz-menu-theme: cannot read $CZ_THEME" >&2; exit 1; }
. "$CZ_THEME"
cz_palette

# Idle screen-blank. Resolved next to cz-theme.sh: both live in /usr/local/lib
# installed, and side by side in the source tree.
CZ_STANDBY="${CZ_STANDBY:-$(dirname "${BASH_SOURCE[0]}")/cz-standby.sh}"
[ -r "$CZ_STANDBY" ] || CZ_STANDBY=/usr/local/lib/cz-standby.sh
[ -r "$CZ_STANDBY" ] || { echo "cz-menu-theme: cannot read cz-standby.sh" >&2; exit 1; }
. "$CZ_STANDBY"

TAB=$'\t'   # literal tab; only `IFS= read -n1` preserves it (see do_standby)
STANDBY_TO_MAIN=""   # set by do_standby in a submenu; unwinds to the main screen

# The standby notice: the shared 53-column box, so it reads as part of the same
# product rather than a separate screensaver. 10 rows, inside the 14-row budget.
standby_screen() {
    local t="S T A N D   B Y" h="press TAB, then ENTER to resume"
    local len l r
    clear
    btop
    title_row_sig "CARDPUTER ZERO"
    bsep
    brow "" ""
    brow "" ""
    len=${#t}; l=$(( (51 - len) / 2 )); r=$(( 51 - len - l ))
    brow "$(sp "$l")$t$(sp "$r")" "$(sp "$l")$TITLE$t$R$(sp "$r")"
    brow "" ""
    len=${#h}; l=$(( (51 - len) / 2 )); r=$(( 51 - len - l ))
    brow "$(sp "$l")$h$(sp "$r")" "$(sp "$l")$DIM$h$R$(sp "$r")"
    brow "" ""
    bbot
}

# Entered when the menu has been idle for the configured timeout. The panel is
# blanked; ANY key wakes it and shows the notice, but does not resume - resuming
# needs TAB followed by ENTER, so a key pressed in a pocket or a brushing finger
# cannot silently drop the user back into the menu.
#
# Every read here uses `IFS=`: without it bash strips TAB as IFS whitespace and
# it arrives as an empty string, indistinguishable from ENTER, which would make
# a bare ENTER resume. Measured, not assumed.
do_standby() {
    local k secs rc
    secs=$(cz_standby_seconds)
    cz_standby_blank
    while :; do
        # Any key wakes the panel. This read is deliberately untimed: the panel
        # is already blank here, so there is nothing to save by timing out. On a
        # tty it blocks until a key arrives; the || guard keeps a closed stdin
        # from spinning, since read returns empty on EOF and an empty string is
        # neither TAB nor a wake key.
        IFS= read -r -n1 -s k || { cz_standby_wake; return 0; }
        # Three phases, not one: unblank while the backlight is still 0, repaint
        # the notice, then bring the light up. Waking fully before the repaint
        # flashed the pre-idle screen for a frame, because the framebuffer still
        # held it - reported from hardware after the first deploy.
        cz_standby_unblank
        standby_screen
        cz_standby_backlight_on
        # The notice is itself an idle surface. Waking it and then walking away
        # without resuming must re-blank rather than hold the backlight on
        # forever, so it gets the same timeout as the menu - one setting governs
        # both. A TAB with no ENTER before the timeout also re-blanks, and the
        # pair must then be entered afresh after the next wake.
        while :; do
            if [ "$secs" -gt 0 ]; then IFS= read -t "$secs" -r -n1 -s k; rc=$?
            else IFS= read -r -n1 -s k; rc=$?; fi
            if [ "$rc" -gt 128 ]; then cz_standby_blank; break; fi
            # EOF, not a timeout. The panel is already awake here, so there is
            # nothing to restore - unlike the outer read, which waits while the
            # panel is blanked and must not leave it dark.
            [ "$rc" -eq 0 ] || return 0
            [ "$k" = "$TAB" ] || continue
            if [ "$secs" -gt 0 ]; then IFS= read -t "$secs" -r -n1 -s k; rc=$?
            else IFS= read -r -n1 -s k; rc=$?; fi
            if [ "$rc" -gt 128 ]; then cz_standby_blank; break; fi
            [ "$rc" -eq 0 ] || return 0
            [ -z "$k" ] && return 0    # TAB then ENTER resumes
        done
    done
}

# Screen-timeout picker. The current setting is marked in place; writing goes
# through cz_standby_set_minutes, which rejects anything not on the list.
#
# This deliberately does NOT use the shared menu() helper. menu() builds its
# label array once and redraws that same array on every keypress, so the
# "(current)" marker would stay on the old value until the user left and
# re-entered the screen. Here the labels are rebuilt from cz_standby_minutes
# inside the loop, so the marker moves the instant a new value is selected.
m_timeout() {
    local cur m label i idx pick k secs rc
    while :; do
        cur=$(cz_standby_minutes)
        hdr "SCREEN TIMEOUT" system
        i=1
        for m in $CZ_STANDBY_CHOICES; do
            if [ "$m" = "$cur" ]; then label="$m min  (current)"; else label="$m min"; fi
            row1 "$i" "$label"
            i=$((i + 1))
        done
        row1 0 "Back"
        bbot
        secs=$(cz_standby_seconds)
        if [ "$secs" -gt 0 ]; then IFS= read -t "$secs" -r -n1 -s k; rc=$?
        else IFS= read -r -n1 -s k; rc=$?; fi
        if [ "$rc" -gt 128 ]; then do_standby; STANDBY_TO_MAIN=1; return; fi
        [ "$k" = 0 ] && return
        if [[ "$k" =~ ^[1-9]$ ]]; then
            # Map the row number back onto the choice list rather than assuming
            # the keys are the minute values themselves.
            idx=0; pick=""
            for m in $CZ_STANDBY_CHOICES; do
                idx=$((idx + 1))
                if [ "$idx" = "$k" ]; then pick="$m"; break; fi
            done
            [ -n "$pick" ] && cz_standby_set_minutes "$pick"
        fi
    done
}

m_hostname() {
    local cur new lbl hint plain colored gap YEL
    YEL=$'\e[93m'
    cur=$(hostnamectl --static 2>/dev/null || cat /etc/hostname)
    lbl='Please enter a new hostname'
    hint='blank = back'
    gap=$(( 51 - 2 - ${#lbl} - ${#hint} - 2 ))
    (( gap < 1 )) && gap=1
    hdr HOSTNAME system
    brow "  current:  ${cur:0:37}" \
         "  ${YEL}current:${R}  ${LBL}${cur:0:37}${R}"
    plain=$(printf '  %s%*s%s  ' "$lbl" "$gap" '' "$hint")
    colored=$(printf '  %s%s%s%*s%s%s%s  ' \
              "$YEL" "$lbl" "$R" "$gap" '' "$YEL" "$hint" "$R")
    brow "$plain" "$colored"
    bbot
    printf '\e[?25h  > '
    read -r new
    [ -n "$new" ] || return 100
    clear
    cz-hostname "$new"
}
# bl/blm/vol/bat/batcol/temp are read-only status getters and live in cz-theme.sh;
# only the mutating actions stay here.
blstep() { local cur max step new
    cur=$(bl); max=$(blm); step=$(( max / 10 )); [ "$step" -lt 1 ] && step=1
    if [ "$1" = "+" ]; then new=$(( cur + step )); else new=$(( cur - step )); fi
    [ "$new" -lt 0 ] && new=0; [ "$new" -gt "$max" ] && new=$max
    echo "$new" > "$BL/brightness" 2>/dev/null; }

MENU_MSG=""; MENU_MSG_UNTIL=0
note() { MENU_MSG="$1"; MENU_MSG_UNTIL=$(( $(date +%s) + 3 )); }
save_levels() {
    if sudo alsactl store 2>/dev/null; then note "levels saved"
    else note "save failed"; fi
}

volstep() { [ -n "$VC" ] && { amixer -c "$CARD" sset "$VC" "$1" unmute >/dev/null 2>&1
                              amixer -c "$CARD" sset DACR "$1" unmute >/dev/null 2>&1; }; }

ir_dev() {
    for d in /dev/lirc*; do
        [ -e "$d" ] || continue
        ir-ctl -d "$d" --features 2>/dev/null \
          | grep -q "Device can $1 raw IR" && { echo "$d"; return 0; }
    done
    return 1
}

menu() {
    local title="$1" mode="${2:-main}"; shift 2
    local -a labels=() cmds=()
    while [ $# -gt 0 ]; do
        labels+=("$1"); cmds+=("$2"); shift 2
    done
    while :; do
        # A standby deeper in the nesting resumes at the MAIN menu, not one level
        # up, so unwind all the way out instead of redrawing this submenu.
        [ -n "$STANDBY_TO_MAIN" ] && { STANDBY_TO_MAIN=""; return; }
        hdr "$title" "$mode"
        local i
        for i in "${!labels[@]}"; do
            row1 "$((i+1))" "${labels[i]}"
        done
        row1 0 "Back"
        if [ -n "$MENU_MSG" ] && [ "$(date +%s)" -lt "$MENU_MSG_UNTIL" ]; then
            brow "  $MENU_MSG" "${DIM}  $MENU_MSG${R}"
        fi
        bbot
        # read -t exits >128 on timeout but 1 on EOF, so the two are separable.
        local secs rc
        secs=$(cz_standby_seconds)
        if [ "$secs" -gt 0 ]; then IFS= read -t "$secs" -r -n1 -s k; rc=$?
        else IFS= read -r -n1 -s k; rc=$?; fi
        if [ "$rc" -gt 128 ]; then do_standby; STANDBY_TO_MAIN=1; return; fi
        [ "$k" = 0 ] && return
        if [[ "$k" =~ ^[1-9]$ ]] && [ "$k" -le "${#cmds[@]}" ]; then
            local cmd="${cmds[$((k-1))]}"
            clear
            if [ "${cmd#!}" != "$cmd" ]; then
                eval "${cmd#!}"
            else
                eval "$cmd"; local rc=$?
                [ "$rc" -eq 100 ] || pause
            fi
        fi
    done
}

sysinfo() {
    uname -srmo; echo; uptime; echo; free -h; echo
    df -h / /boot/firmware 2>/dev/null; echo
    have vcgencmd && vcgencmd measure_temp
    echo; systemctl is-active lcd-console cz-keymap 2>/dev/null
}

m_audio() {
    menu AUDIO audio \
      "Volume +5%"    '!volstep 5%+' \
      "Volume -5%"    '!volstep 5%-' \
      "Mute toggle"   'amixer -c "$CARD" sset Speaker toggle' \
      "Speaker test"  'speaker-test -D default -c 2 -t sine -l 1' \
      "Save levels"   '!save_levels'
}

m_adapters() {
    local act="${1:-}"
    local -a devs=() args=()
    mapfile -t devs < <(nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2=="wifi"{print $1}')
    if [ "${#devs[@]}" -eq 0 ]; then echo "no wifi device found"; pause; return; fi
    local d
    for d in "${devs[@]}"; do
        args+=("$(cz-wifi label "$d")" "cz-wifi $act $d")
    done
    menu ADAPTER net "${args[@]}"
}

m_net() {
    menu WIFI main \
      "Radio on/off"    'cz-wifi radio' \
      "Scan and join"   '!m_adapters scan' \
      "Hidden network"  '!m_adapters hidden' \
      "Network"         'ip -brief addr; ip route'
}

m_ir() {
    menu IR main \
      "Devices"        'ir-keytable 2>/dev/null | head -20' \
      "Receive 5s"     'd=$(ir_dev receive) && sudo timeout 5 ir-ctl -r -d "$d"' \
      "Record button"  'printf "name: "; read -r n; cz-ir rec "$n" 5' \
      "Replay button"  'cz-ir list; printf "name: "; read -r n; cz-ir send "$n"' \
      "Saved buttons"  'cz-ir list' \
      "All protocols"  'sudo ir-keytable -p all'
}


m_system() {
    menu SYSTEM system \
      "Audio"         '!m_audio' \
      "Display"       '!m_display' \
      "Screen timeout" '!m_timeout' \
      "Hostname"        'm_hostname' \
      "Power"         '!m_power'
}

m_display() {
    menu DISPLAY system \
      "Backlight +"     '!blstep +' \
      "Backlight -"     '!blstep -' \
      "Output: monitor" '!cz-output monitor' \
      "Output: panel"   '!cz-output panel'
}

m_power() {
    menu POWER main \
      "Battery detail" 'for p in /sys/class/power_supply/*; do echo "== $p"; for f in capacity status voltage_now current_now temp health; do [ -r "$p/$f" ] && printf "  %-14s %s\n" "$f" "$(cat "$p/$f")"; done; done' \
      "CPU / thermal"  'cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null; vcgencmd measure_temp 2>/dev/null; vcgencmd get_throttled 2>/dev/null' \
      "Uptime / load"  'uptime; cat /proc/loadavg' \
      "Reboot"         '!ask "Reboot the device?" && sudo reboot'
}

do_logout() {
    ask "Logout of CardputerZero?" || return
    clear
    [ -n "${XDG_SESSION_ID:-}" ] && loginctl terminate-session "$XDG_SESSION_ID" 2>/dev/null
    exit 0
}

need() {
    command -v "$1" >/dev/null 2>&1 && return 0
    printf '%s not installed.\npress any key' "$1"
    read -r -n1 -s _
    return 1
}

# Main screen. Kept as a function so tests/cz-menu-theme-layout.sh can render the
# real thing instead of a hand-copied mirror that can silently drift.
main_screen() {
    hdr "CARDPUTER ZERO" main
    row2 1 "Camera" 5 "IR"
    row2 2 "Music"  6 "System"
    row2 3 "News"   7 "CLI"
    row2 4 "Recorder" 8 "WiFi"
    row2 9 "Files"  0 "Logout"
    bsep
    brow "  press a number to select" "${DIM}  press a number to select${R}"
    bbot
}

while :; do
    STANDBY_TO_MAIN=""
    main_screen
    secs=$(cz_standby_seconds)
    if [ "$secs" -gt 0 ]; then IFS= read -t "$secs" -r -n1 -s k; rc=$?
    else IFS= read -r -n1 -s k; rc=$?; fi
    if [ "$rc" -gt 128 ]; then do_standby; continue; fi
    case "$k" in
      1) if cz-camera-present; then need camera_app && cz-camera; else echo "No camera detected"; sleep 2; fi ;;
      2) need cmus && cmus ;;
      3) need newsboat && cz-news ;;
      4) need cz-record && cz-record ;;
      5) m_ir ;;
      6) m_system ;;
      7) clear; tmux -f /etc/cz-tmux.conf new-session -A -s main ;;
      8) m_net ;;
      9) need cz-files && cz-files ;;
      0) do_logout ;;
    esac
done
