#!/bin/bash
# cz-wifi — compact WiFi control for a 53-column console
#
# The Bars line comes from cz-signal.sh, the same helper cz-theme.sh sources
# for the bars in every menu header, so the two cannot drift onto different
# scales. Installed it lives in /usr/local/lib; in the source tree it sits next
# to this file, which is what the tests rely on.
CZ_SIGNAL="${CZ_SIGNAL:-/usr/local/lib/cz-signal.sh}"
[ -r "$CZ_SIGNAL" ] || CZ_SIGNAL="$(dirname "${BASH_SOURCE[0]}")/cz-signal.sh"
[ -r "$CZ_SIGNAL" ] || { echo "cz-wifi: cannot read cz-signal.sh" >&2; exit 1; }
. "$CZ_SIGNAL"

IFACE=$(nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}')

need() { [ -n "$IFACE" ] || { echo "no wifi device found"; exit 1; }; }

# nmcli -t escapes ':' as '\:' and '\' as '\\'. Split a terse line into
# the NM_F array, decoding escapes in a single left-to-right pass.
NM_F=()
nm_fields() {
    NM_F=()
    local line="$1" out='' ch esc='' i
    for (( i = 0; i < ${#line}; i++ )); do
        ch="${line:i:1}"
        if [ -n "$esc" ]; then
            out+="$ch"; esc=''
        elif [ "$ch" = '\' ]; then
            esc=1
        elif [ "$ch" = : ]; then
            NM_F+=("$out"); out=''
        else
            out+="$ch"
        fi
    done
    NM_F+=("$out")
}

iface_label() {
    local p; p=$(readlink -f "/sys/class/net/$1/device" 2>/dev/null)
    case "$p" in
        *usb*) printf '%s  USB dongle' "$1" ;;
        *mmc*) printf '%s  internal' "$1" ;;
        *)     printf '%s' "$1" ;;
    esac
}

# Report which bus a WiFi interface sits on: usb / mmc (internal) / other.
iface_bus() {
    local p; p=$(readlink -f "/sys/class/net/$1/device" 2>/dev/null)
    case "$p" in
        *usb*) echo usb ;;
        *mmc*) echo mmc ;;
        *)     echo other ;;
    esac
}

# wlan0 is the primary internal radio; anything else must be a USB dongle
# to be selectable.
check_iface() {
    [ -d "/sys/class/net/$IFACE" ] || { echo "no such interface: $IFACE"; return 1; }
    if [ "$IFACE" != wlan0 ] && [ "$(iface_bus "$IFACE")" != usb ]; then
        echo "no USB WiFi dongle on $IFACE"
        echo "plug one in, or use wlan0"
        return 1
    fi
}

# Always prompt, even with one adapter. brcmfmac exposes wlan0 and wlan1,
# so a USB dongle is usually wlan2 - enumerate, never guess by name.
pick_iface() {
    local -a devs=()
    mapfile -t devs < <(nmcli -t -f DEVICE,TYPE device 2>/dev/null \
                        | awk -F: '$2=="wifi"{print $1}')
    if [ "${#devs[@]}" -eq 0 ]; then echo "no wifi device found"; return 1; fi
    local i n
    while :; do
        clear
        echo "select adapter:"
        for i in "${!devs[@]}"; do
            printf '%2d %s
' "$((i+1))" "$(iface_label "${devs[i]}")"
        done
        printf 'number (0=cancel): '
        read -r n
        [[ "$n" =~ ^[1-9]$ ]] && [ "$n" -le "${#devs[@]}" ] || { echo cancelled; return 1; }
        IFACE="${devs[$((n-1))]}"
        if [ "$IFACE" != wlan0 ] && [ "$(iface_bus "$IFACE")" != usb ]; then
            echo
            echo "no USB WiFi dongle on $IFACE"
            echo "plug one in, or select wlan0"
            sleep 2
            continue
        fi
        return 0
    done
}

join() {
    local ssid="$1" pw="$2" sec="$3" hid="${4:-no}" km
    if echo "$sec" | grep -qi '802.1X\|EAP'; then
        echo "enterprise network - configure manually with nmcli"
        return 1
    fi
    if [ -z "$pw" ]; then
        nmcli connection delete "$ssid" >/dev/null 2>&1
        nmcli connection add type wifi con-name "$ssid" ifname "$IFACE" \
            ssid "$ssid" wifi.hidden "$hid" >/dev/null || return 1
        nmcli connection up "$ssid"
        return
    fi
    local cands="wpa-psk"
    echo "$sec" | grep -qi 'SAE\|WPA3' && cands="sae wpa-psk"
    for km in $cands; do
        nmcli connection delete "$ssid" >/dev/null 2>&1
        nmcli connection add type wifi con-name "$ssid" ifname "$IFACE" \
            ssid "$ssid" wifi.hidden "$hid" \
            wifi-sec.key-mgmt "$km" wifi-sec.psk "$pw" >/dev/null || continue
        nmcli connection up "$ssid" && return 0
    done
    echo "could not join $ssid"
    return 1
}

radio() {
    if [ "$(nmcli radio wifi 2>/dev/null)" = enabled ]; then
        nmcli radio wifi off && echo "WiFi OFF"
    else
        nmcli radio wifi on  && echo "WiFi ON"
    fi
}

scan() {
    if [ -n "${1:-}" ]; then
        IFACE="$1"
        if [ "$IFACE" != wlan0 ] && [ "$(iface_bus "$IFACE")" != usb ]; then
            echo "no USB WiFi dongle on $IFACE"
            echo "plug one in, or select wlan0"
            sleep 2
            return 1
        fi
    else
        pick_iface || return 1
    fi
    echo "scanning..."
    nmcli device wifi rescan ifname "$IFACE" >/dev/null 2>&1
    sleep 3
    local -a ssids=() sigs=() secs=()
    local -A seen=()
    local line ssid sig sec
    while IFS= read -r line && [ "${#ssids[@]}" -lt 9 ]; do
        [ -n "$line" ] || continue
        nm_fields "$line"
        [ "${#NM_F[@]}" -eq 3 ] || continue
        ssid="${NM_F[0]}"; sig="${NM_F[1]}"; sec="${NM_F[2]}"
        [ -n "$ssid" ] || continue
        [ -n "${seen[$ssid]:-}" ] && continue
        seen[$ssid]=1
        ssids+=("$ssid"); sigs+=("$sig"); secs+=("$sec")
    done < <(nmcli -t -f SSID,SIGNAL,SECURITY device wifi list ifname "$IFACE" 2>/dev/null)

    if [ "${#ssids[@]}" -eq 0 ]; then echo "no networks found"; return 1; fi
    local i
    for i in "${!ssids[@]}"; do
        printf '%2d %-24.24s %3s%% %s\n' \
               "$((i+1))" "${ssids[i]}" "${sigs[i]}" "${secs[i]}"
    done
    printf 'number (0=cancel): '
    read -r n
    [[ "$n" =~ ^[1-9]$ ]] && [ "$n" -le "${#ssids[@]}" ] || return 100
    local s="${ssids[$((n-1))]}" sec="${secs[$((n-1))]}"
    if [ -n "$sec" ] && [ "$sec" != "--" ]; then
        printf 'password: '; read -r pw
        join "$s" "$pw" "$sec" no
    else
        join "$s" "" "$sec" no
    fi
}

hidden() {
    if [ -n "${1:-}" ]; then
        IFACE="$1"
        if [ "$IFACE" != wlan0 ] && [ "$(iface_bus "$IFACE")" != usb ]; then
            echo "no USB WiFi dongle on $IFACE"
            echo "plug one in, or select wlan0"
            sleep 2
            return 1
        fi
    else
        pick_iface || return 1
    fi
    printf 'SSID: '; read -r ssid
    [ -n "$ssid" ] || { echo cancelled; return 0; }
    printf 'password (blank=open): '; read -r pw
    join "$ssid" "$pw" "WPA2 WPA3" yes
}

signal() {
    need
    local cur
    cur=$(nmcli -t -f ACTIVE,SSID,SIGNAL,RATE,CHAN device wifi list ifname "$IFACE" 2>/dev/null | grep '^yes:' | head -1)
    if [ -z "$cur" ]; then
        echo "not connected"
        nmcli -t -f DEVICE,STATE,CONNECTION device 2>/dev/null | grep '^'"$IFACE"':'
        return 0
    fi
    nm_fields "$cur"
    local ssid="${NM_F[1]}" sig="${NM_F[2]}" rate="${NM_F[3]}" chan="${NM_F[4]}"
    # Bars are read live from /proc/net/wireless while Signal above is nmcli's
    # cached scan percentage, so the two can disagree by a few dB.
    printf 'SSID   %s\nSignal %s%%\nRate   %s\nChan   %s\nBars   %s\n' \
           "$ssid" "$sig" "$rate" "$chan" "$(sig_bars)"
    ip -brief addr show "$IFACE" 2>/dev/null
}

case "${1:-}" in
    radio)  radio ;;
    scan)   scan "${2:-}" ;;
    hidden) hidden "${2:-}" ;;
    signal) signal ;;
    label)  iface_label "${2:-wlan0}"; echo ;;
    *) echo "usage: cz-wifi radio|scan|hidden|signal"; exit 1 ;;
esac
