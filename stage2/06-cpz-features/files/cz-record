#!/bin/bash
# cz-record — voice memos from the CardputerZero MEMS mic via the ES8389 ADC.
CARD=ES8389Audio
CAPDEV="plughw:CARD=${CARD},DEV=0"
DIR="${CZ_RECORD_DIR:-$HOME/Recordings}"
RATE="${CZ_RECORD_RATE:-48000}"
CH="${CZ_RECORD_CH:-1}"
FMT="${CZ_RECORD_FMT:-S16_LE}"
# "ADCL"/"ADCR" capture volume is declared as -95.5dB + 0.5dB/step, so 0 would be
# effectively silent. 191 == 0 dBFS, which is also what this driver already sets.
GAIN="${CZ_RECORD_GAIN:-191}"
PROBE_SEC="${CZ_RECORD_PROBE:-2}"
CARDS="${CZ_RECORD_CARDS:-/proc/asound/cards}"

have()  { command -v "$1" >/dev/null 2>&1; }
pause() { printf '\npress any key'; read -r -n1 -s _; }

card_ok() { grep -q ES8389 "$CARDS" 2>/dev/null; }

# Bring up the capture path. Measured on real hardware (czero1, 2026-11-24): the
# driver and DT already leave ADC MUX=AMIC, Mic Jack=on and ADCL/ADCR at 191, so
# this is defence against a bad `alsactl restore`, not a required setup step.
# Note the ALSA simple-control names are the short ones ("ADCL", not
# "ADCL Capture Volume"); amixer strips the Volume/Switch suffixes.
# PGAL/PGAR Select and the ADC PGA gain are deliberately left alone: PGA 14 was
# measured to clip (peak -0.0dB) and the DT default of 8 (24dB) is correct.
setup_mic() {
    amixer -c "$CARD" sset 'ADC MUX' AMIC >/dev/null 2>&1
    amixer -c "$CARD" sset 'Mic Jack' on  >/dev/null 2>&1
    amixer -c "$CARD" sset 'ADCL' "$GAIN" >/dev/null 2>&1
    amixer -c "$CARD" sset 'ADCR' "$GAIN" >/dev/null 2>&1
}

# ctl <name> — one line of the capture path's current state, for `check`.
ctl() {
    local v
    v=$(amixer -c "$CARD" sget "$1" 2>/dev/null \
        | grep -oE "Item0: '[^']*'|\[(on|off)\]|\[-?[0-9.]+dB\]" | head -1 \
        | sed -e "s/^Item0: '//" -e "s/'$//" -e 's/^\[//' -e 's/\]$//')
    printf '  %-13s %s\n' "$1" "${v:-?}"
}

# level <wav> -> "SECONDS PEAK_DB RMS_DB"; audioop is gone in py3.13, use array.
level() {
    have python3 || { echo '0 -99.0 -99.0'; return 0; }
    python3 - "$1" <<'PY' 2>/dev/null
import array, math, sys, wave
try:
    w = wave.open(sys.argv[1], 'rb')
    sw, ch, fr = w.getsampwidth(), w.getnchannels(), w.getframerate()
    raw = w.readframes(w.getnframes())
    w.close()
except Exception:
    print('0 -99.0 -99.0'); sys.exit(0)
if sw != 2 or not raw:
    print('0 -99.0 -99.0'); sys.exit(0)
a = array.array('h'); a.frombytes(raw[:len(raw) // 2 * 2])
if ch > 1:
    a = a[0::ch]
if not len(a):
    print('0 -99.0 -99.0'); sys.exit(0)
peak = max(abs(int(x)) for x in a)
rms = math.sqrt(sum(int(x) * int(x) for x in a) / len(a))
db = lambda v: 20 * math.log10(v / 32768.0) if v > 0 else -99.0
print('%.1f %.1f %.1f' % (len(a) / float(fr), db(peak), db(rms)))
PY
}

silent() { awk -v p="$1" 'BEGIN{exit !(p < -60)}'; }

# Newest first; RECS holds absolute paths.
map_recs() {
    RECS=()
    [ -d "$DIR" ] || return 0
    mapfile -d '' -t RECS < <(find "$DIR" -maxdepth 1 -name '*.wav' -type f \
        -printf '%T@ %p\0' 2>/dev/null | sort -z -rn | cut -zd' ' -f2-)
}

# resolve <n|basename> -> RES
resolve() {
    map_recs
    local a="$1" f
    [ "${#RECS[@]}" -gt 0 ] || return 1
    if [[ "$a" =~ ^[0-9]+$ ]] && [ "$a" -ge 1 ] && [ "$a" -le "${#RECS[@]}" ]; then
        RES="${RECS[$((a-1))]}"; return 0
    fi
    for f in "${RECS[@]}"; do
        [ "$(basename "$f" .wav)" = "$a" ] && { RES="$f"; return 0; }
    done
    return 1
}

# True while <pid> is still running. `kill -0` is not enough: a child that has
# exited but not yet been reaped is a zombie and still answers to it, which would
# spin the loop below forever once arecord stops on its own (e.g. -d expired).
running() {
    local s
    [ -r "/proc/$1/stat" ] || return 1
    s=$(sed -e 's/.*) //' -e 's/ .*//' "/proc/$1/stat" 2>/dev/null)
    [ -n "$s" ] && [ "$s" != Z ]
}

# Run <cmd> in the background, tick a clock, and stop it on the first keypress.
# SIGINT (not SIGKILL) so arecord writes a correct WAV header. Elapsed time comes
# from the clock, not a loop counter: with no tty on stdin `read -t 1` returns
# immediately, so counting iterations would spin the display. Without a tty there
# is no key to stop on, so just wait for the capture to finish on its own.
run_timed() {
    local label="$1"; shift
    "$@" < /dev/null &
    local pid=$! start t
    start=$(date +%s)
    if [ -t 0 ]; then
        while running "$pid"; do
            t=$(( $(date +%s) - start ))
            printf '\r  %s %02d:%02d  ' "$label" $((t/60)) $((t%60))
            read -r -t 1 -n1 -s _ && break
        done
        kill -INT "$pid" 2>/dev/null
    fi
    wait "$pid" 2>/dev/null
    t=$(( $(date +%s) - start ))
    printf '\r  %s %02d:%02d\n' "$label" $((t/60)) $((t%60))
}

do_record() {
    local name="${1:-}" secs="${2:-}" ts out dur peak rms
    card_ok  || { echo "no ES8389 sound card"; return 1; }
    have arecord || { echo "arecord not installed"; return 1; }
    mkdir -p "$DIR" || { echo "cannot create $DIR"; return 1; }

    # Without a tty there is no key to stop on, so a duration is mandatory --
    # otherwise the capture would run until the SD card filled.
    local -a cmd=(arecord -q -D "$CAPDEV" -f "$FMT" -c "$CH" -r "$RATE")
    if [ -n "$secs" ]; then
        [[ "$secs" =~ ^[0-9]+$ ]] || { echo "seconds must be a number"; return 1; }
        cmd+=(-d "$secs")
    elif [ ! -t 0 ]; then
        echo "not a tty: give a duration, e.g."
        echo "  cz-record rec note 10"
        return 1
    fi

    ts=$(date +%Y%m%d-%H%M%S)
    if [ -n "$name" ]; then out="$DIR/${name}-${ts}.wav"
    else out="$DIR/REC-${ts}.wav"; fi

    setup_mic
    printf 'rec -> %.46s\n  speak now%s\n' "${out##*/}" \
        "$([ -t 0 ] && [ -z "$secs" ] && echo ', any key to stop')"
    run_timed 'rec' "${cmd[@]}" "$out"

    if [ ! -s "$out" ]; then
        rm -f "$out"; echo "nothing captured"; return 4
    fi
    set -- $(level "$out"); dur="$1"; peak="$2"; rms="$3"
    printf 'saved %.46s\n' "${out##*/}"
    printf '  %ss  peak %sdB  rms %sdB\n' "$dur" "$peak" "$rms"
    if silent "$peak"; then
        echo 'WARNING: essentially silent.'
        echo '  try: cz-record check'
        echo '  then: cz-record gain 210'
    fi
}

do_play() {
    local f="${1:-}"
    have aplay || { echo "aplay not installed"; return 1; }
    if [ -n "$f" ]; then
        resolve "$f" || { echo "no recording: $f"; return 1; }
        f="$RES"
    else
        pick 'play which?' || return 1
        f="${RECS[$PICK]}"
    fi
    printf 'play %s%s\n' "$(basename "$f")" \
        "$([ -t 0 ] && echo '  any key to stop')"
    run_timed 'play' aplay -q -D default "$f"
}

do_delete() {
    local f="${1:-}"
    if [ -n "$f" ]; then
        resolve "$f" || { echo "no recording: $f"; return 1; }
        f="$RES"
    else
        pick 'delete which?' || return 1
        f="${RECS[$PICK]}"
    fi
    printf 'delete %s? [Y/N] ' "$(basename "$f")"
    read -r -n1 c; echo
    case "$c" in
      y|Y) rm -f "$f" && echo deleted ;;
      *)   echo kept ;;
    esac
}

do_list() {
    map_recs
    if [ "${#RECS[@]}" -eq 0 ]; then echo "none in $DIR"; return 0; fi
    local f i=0 dur peak rms n
    for f in "${RECS[@]}"; do
        i=$((i+1))
        set -- $(level "$f"); dur="$1"; peak="$2"; rms="$3"
        n="$(basename "$f" .wav)"
        printf ' %2d %-26.26s %5ss %6sdB\n' "$i" "$n" "$dur" "$peak"
    done
    echo "dir: ${DIR:0:48}"
}

# Record a short probe and report whether the mic actually produced signal.
do_check() {
    local tmp dur peak rms
    card_ok || { echo "no ES8389 sound card"; return 1; }
    have arecord || { echo "arecord not installed"; return 1; }

    echo "== MIC CHECK =="
    grep ES8389 "$CARDS" 2>/dev/null | head -1 | cut -c1-53
    echo "capture path:"
    ctl 'ADC MUX'; ctl 'Mic Jack'; ctl 'ADCL'
    ctl 'ADCL PGA'; ctl 'PGAL Select'; ctl 'PGAR Select'

    tmp=$(mktemp /tmp/cz-micprobe-XXXXXX.wav) || return 1
    setup_mic
    printf 'probing %ss - speak now\n' "$PROBE_SEC"
    arecord -q -D "$CAPDEV" -f "$FMT" -c "$CH" -r "$RATE" -d "$PROBE_SEC" "$tmp" < /dev/null

    set -- $(level "$tmp"); dur="$1"; peak="$2"; rms="$3"
    rm -f "$tmp"
    printf 'result: %ss  peak %sdB  rms %sdB\n' "$dur" "$peak" "$rms"
    if silent "$peak"; then
        echo '-> SILENT. Likely causes:'
        echo '   1. Mic Jack off, or ADC MUX set'
        echo '      to DMIC (see above)'
        echo '   2. capture gain too low:'
        echo '      cz-record gain 210'
        echo '   3. another process holds the card'
        return 4
    fi
    echo '-> mic is picking up signal'
}

do_gain() {
    local g="${1:?usage: cz-record gain <0-255>  (191 = 0dB)}"
    [[ "$g" =~ ^[0-9]+$ ]] && [ "$g" -le 255 ] || { echo "gain must be 0-255"; return 1; }
    GAIN="$g"
    amixer -c "$CARD" sset 'ADCL' "$GAIN" >/dev/null 2>&1 \
        || { echo "no ADCL capture control"; return 1; }
    amixer -c "$CARD" sset 'ADCR' "$GAIN" >/dev/null 2>&1
    printf 'capture volume = %s (%s dB)\n' "$GAIN" \
        "$(awk -v g="$GAIN" 'BEGIN{printf "%.1f", -95.5 + g*0.5}')"
    echo 'persist with: Audio menu -> Save levels'
}

# pick <prompt> -> PICK (index into RECS); newest 9 fit the 14-row console.
pick() {
    map_recs
    [ "${#RECS[@]}" -gt 0 ] || { echo "no recordings in $DIR"; return 1; }
    local i n show=9
    while :; do
        clear
        echo "== RECORDINGS =="
        i=0
        for n in "${RECS[@]}"; do
            [ "$i" -ge "$show" ] && break
            i=$((i+1))
            printf ' %d %s\n' "$i" "$(basename "$n" .wav)"
        done
        [ "${#RECS[@]}" -gt "$show" ] \
            && echo "   ...and $(( ${#RECS[@]} - show )) older"
        echo " 0 Back"
        printf '%s ' "$1"
        read -r -n1 -s k; echo
        [ "$k" = 0 ] && return 1
        [[ "$k" =~ ^[1-9]$ ]] && [ "$k" -le "$i" ] && { PICK=$((k-1)); return 0; }
    done
}

do_menu() {
    while :; do
        clear
        map_recs
        echo "== RECORDER =="
        echo "  mic: $(card_ok && echo ES8389 || echo absent)   saved: ${#RECS[@]}"
        printf '  dir: %.45s\n' "$DIR"
        echo ' 1 Record'
        echo ' 2 Play'
        echo ' 3 Delete'
        echo ' 4 Mic check'
        echo ' 0 Back'
        read -r -n1 -s k
        case "$k" in
          1) clear; printf 'name (blank = REC-timestamp): '; read -r n
             do_record "$n"; pause ;;
          2) clear; do_play;   pause ;;
          3) clear; do_delete; pause ;;
          4) clear; do_check;  pause ;;
          0) return ;;
        esac
    done
}

case "${1:-}" in
  rec)   do_record "${2:-}" "${3:-}" ;;
  play)  do_play   "${2:-}" ;;
  del)   do_delete "${2:-}" ;;
  rm)    do_delete "${2:-}" ;;
  list)  do_list ;;
  ls)    do_list ;;
  check) do_check ;;
  gain)  do_gain "${2:-}" ;;
  '')    do_menu ;;
  *)     echo 'usage: cz-record <command>'
         echo '  rec [name] [s] record a voice memo'
         echo '  play <n|name>  play a recording'
         echo '  del  <n|name>  delete a recording'
         echo '  list           list recordings'
         echo '  check          test the mic'
         echo '  gain <0-255>   set capture gain'
         exit 1 ;;
esac
