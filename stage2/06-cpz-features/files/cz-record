#!/bin/bash
# cz-record — voice memos from the CardputerZero MEMS mic via the ES8389 ADC.
# Screens use the shared 53x14 theme (cz-theme.sh), the same one cz-menu-theme
# draws, so the recorder matches the menu that launches it.
CZ_THEME="${CZ_THEME:-/usr/local/lib/cz-theme.sh}"
[ -r "$CZ_THEME" ] || { echo "cz-record: cannot read $CZ_THEME" >&2; exit 1; }
. "$CZ_THEME"

CAPDEV="plughw:CARD=${CARD},DEV=0"
DIR="${CZ_RECORD_DIR:-$HOME/Recordings}"
RATE="${CZ_RECORD_RATE:-48000}"
CH="${CZ_RECORD_CH:-1}"
FMT="${CZ_RECORD_FMT:-S16_LE}"
# "ADCL"/"ADCR" capture volume is declared as -95.5dB + 0.5dB/step, so 0 would be
# effectively silent. 191 == 0 dBFS, which is also what this driver already sets.
GAIN="${CZ_RECORD_GAIN:-191}"
PROBE_SEC="${CZ_RECORD_PROBE:-2}"
CARDS="${CZ_RECORD_CARDS:-/proc/asound/cards}"

card_ok() { grep -q ES8389 "$CARDS" 2>/dev/null; }

# Bring up the capture path. Measured on real hardware (a CardputerZero,
# 2026-11-24): the driver and DT already leave ADC MUX=AMIC, Mic Jack=on and
# ADCL/ADCR at 191, so this is defence against a bad `alsactl restore`, not a
# required setup step.
# Note the ALSA simple-control names are the short ones ("ADCL", not
# "ADCL Capture Volume"); amixer strips the Volume/Switch suffixes.
# PGAL/PGAR Select and the ADC PGA gain are deliberately left alone: PGA 14 was
# measured to clip (peak -0.0dB) and the DT default of 8 (24dB) is correct.
setup_mic() {
    amixer -c "$CARD" sset 'ADC MUX' AMIC >/dev/null 2>&1
    amixer -c "$CARD" sset 'Mic Jack' on  >/dev/null 2>&1
    amixer -c "$CARD" sset 'ADCL' "$GAIN" >/dev/null 2>&1
    amixer -c "$CARD" sset 'ADCR' "$GAIN" >/dev/null 2>&1
}

# ctlval <name> — one capture control's current value, unwrapped from the amixer
# decoration ("Item0: 'AMIC'" -> AMIC, "[0.00dB]" -> 0.00dB).
ctlval() {
    amixer -c "$CARD" sget "$1" 2>/dev/null \
        | grep -oE "Item0: '[^']*'|\[(on|off)\]|\[-?[0-9.]+dB\]" | head -1 \
        | sed -e "s/^Item0: '//" -e "s/'$//" -e 's/^\[//' -e 's/\]$//'
}
# ctlrow <name> <value> [<name2> <value2>] — boxed row for the mic check screen.
# Fields are 12 wide, not 11: the longest control name ("PGAL Select") is exactly
# 11 characters, so an 11-wide field would run straight into its value.
ctlrow() {
    local plain colored
    if [ -n "${3:-}" ]; then
        plain=$(printf '  %-12s%-12s%-12s%s' "$1" "${2:-?}" "$3" "${4:-?}")
        colored=$(printf '  %s%-12s%s%s%-12s%s%s%-12s%s%s%s%s' \
            "$DIM" "$1" "$R" "$LBL" "${2:-?}" "$R" "$DIM" "$3" "$R" "$LBL" "${4:-?}" "$R")
    else
        plain=$(printf '  %-12s%s' "$1" "${2:-?}")
        colored=$(printf '  %s%-12s%s%s%s%s' "$DIM" "$1" "$R" "$LBL" "${2:-?}" "$R")
    fi
    brow "$plain" "$colored"
}
# info <plain> <colored> — a boxed caption row.
info() { brow "$1" "$2"; }

# level <wav> -> "SECONDS PEAK_DB RMS_DB"; audioop is gone in py3.13, use array.
level() {
    have python3 || { echo '0 -99.0 -99.0'; return 0; }
    python3 - "$1" <<'PY' 2>/dev/null
import array, math, sys, wave
try:
    w = wave.open(sys.argv[1], 'rb')
    sw, ch, fr = w.getsampwidth(), w.getnchannels(), w.getframerate()
    raw = w.readframes(w.getnframes())
    w.close()
except Exception:
    print('0 -99.0 -99.0'); sys.exit(0)
if sw != 2 or not raw:
    print('0 -99.0 -99.0'); sys.exit(0)
a = array.array('h'); a.frombytes(raw[:len(raw) // 2 * 2])
if ch > 1:
    a = a[0::ch]
if not len(a):
    print('0 -99.0 -99.0'); sys.exit(0)
peak = max(abs(int(x)) for x in a)
rms = math.sqrt(sum(int(x) * int(x) for x in a) / len(a))
db = lambda v: 20 * math.log10(v / 32768.0) if v > 0 else -99.0
print('%.1f %.1f %.1f' % (len(a) / float(fr), db(peak), db(rms)))
PY
}

silent() { awk -v p="$1" 'BEGIN{exit !(p < -60)}'; }

# Newest first; RECS holds absolute paths.
map_recs() {
    RECS=()
    [ -d "$DIR" ] || return 0
    mapfile -d '' -t RECS < <(find "$DIR" -maxdepth 1 -name '*.wav' -type f \
        -printf '%T@ %p\0' 2>/dev/null | sort -z -rn | cut -zd' ' -f2-)
}

# resolve <n|basename> -> RES
resolve() {
    map_recs
    local a="$1" f
    [ "${#RECS[@]}" -gt 0 ] || return 1
    if [[ "$a" =~ ^[0-9]+$ ]] && [ "$a" -ge 1 ] && [ "$a" -le "${#RECS[@]}" ]; then
        RES="${RECS[$((a-1))]}"; return 0
    fi
    for f in "${RECS[@]}"; do
        [ "$(basename "$f" .wav)" = "$a" ] && { RES="$f"; return 0; }
    done
    return 1
}

# True while <pid> is still running. `kill -0` is not enough: a child that has
# exited but not yet been reaped is a zombie and still answers to it, which would
# spin the loop below forever once arecord stops on its own (e.g. -d expired).
running() {
    local s
    [ -r "/proc/$1/stat" ] || return 1
    s=$(sed -e 's/.*) //' -e 's/ .*//' "/proc/$1/stat" 2>/dev/null)
    [ -n "$s" ] && [ "$s" != Z ]
}

# tick <seconds> <hint> [final] — draw, or redraw in place, the elapsed-time row.
# On a tty it animates over the previous row. When piped (tests, ssh capture) the
# cursor-up escape would corrupt the output, so only the final row is printed --
# still enough to see how long the capture ran, without one line per second.
TICK_DRAWN=0
tick() {
    local m=$(( 10#$1 / 60 )) s=$(( 10#$1 % 60 )) plain colored
    if [ -t 1 ]; then
        [ "$TICK_DRAWN" = 1 ] && printf '\e[1A\r'
    else
        [ "${3:-}" = final ] || return 0
    fi
    TICK_DRAWN=1
    plain=$(printf '  %02d:%02d  %s' "$m" "$s" "$2")
    colored=$(printf '  %s%02d:%02d%s  %s%s%s' "$ACCENT" "$m" "$s" "$R" "$DIM" "$2" "$R")
    brow "$plain" "$colored"
}

# Run <cmd> in the background and stop it on the first keypress.
# SIGINT (not SIGKILL) so arecord finalises the WAV header. Elapsed time comes
# from the clock, not a loop counter: with no tty on stdin `read -t 1` returns
# immediately, so counting iterations would spin the display. Without a tty there
# is no key to stop on, so just wait for the capture to finish on its own.
run_timed() {
    local hint="$1"; shift
    "$@" < /dev/null &
    local pid=$! start t rc
    start=$(date +%s)
    if [ -t 0 ]; then
        while running "$pid"; do
            t=$(( $(date +%s) - start ))
            tick "$t" "$hint"
            read -r -t 1 -n1 -s _
            rc=$?
            [ "$rc" = 0 ] && break
            # Above 128 means the -t timeout expired, which is the normal tick.
            # EOF or a terminal error (EINTR while setting termios) returns <=128;
            # looping on that spins at full CPU for as long as the capture runs.
            [ "$rc" -gt 128 ] || break
        done
        kill -INT "$pid" 2>/dev/null
    fi
    wait "$pid" 2>/dev/null
    ELAPSED=$(( $(date +%s) - start ))
    tick "$ELAPSED" "$hint" final
}

do_record() {
    local name="${1:-}" secs="${2:-}" ts out fn dur peak rms hint
    card_ok  || { echo "no ES8389 sound card"; return 1; }
    have arecord || { echo "arecord not installed"; return 1; }
    mkdir -p "$DIR" || { echo "cannot create $DIR"; return 1; }

    # Without a tty there is no key to stop on, so a duration is mandatory --
    # otherwise the capture would run until the SD card filled.
    local -a cmd=(arecord -q -D "$CAPDEV" -f "$FMT" -c "$CH" -r "$RATE")
    if [ -n "$secs" ]; then
        [[ "$secs" =~ ^[0-9]+$ ]] || { echo "seconds must be a number"; return 1; }
        cmd+=(-d "$secs"); hint="recording ${secs}s"
    elif [ ! -t 0 ]; then
        echo "not a tty: give a duration, e.g."
        echo "  cz-record rec note 10"
        return 1
    else
        hint="speak now, any key to stop"
    fi

    ts=$(date +%Y%m%d-%H%M%S)
    if [ -n "$name" ]; then out="$DIR/${name}-${ts}.wav"
    else out="$DIR/REC-${ts}.wav"; fi
    fn="${out##*/}"; fn=${fn:0:44}

    setup_mic
    hdr "RECORDING" audio
    info "  -> $fn" "  ${DIM}->${R} ${LBL}$fn${R}"
    TICK_DRAWN=0; tick 0 "$hint"
    run_timed "$hint" "${cmd[@]}" "$out"

    if [ ! -s "$out" ]; then
        rm -f "$out"
        info "  nothing captured" "  ${BAD}nothing captured${R}"
        bbot
        return 4
    fi
    set -- $(level "$out"); dur="$1"; peak="$2"; rms="$3"
    info "$(printf '  %ss  peak %sdB  rms %sdB' "$dur" "$peak" "$rms")" \
         "$(printf '  %s%ss%s  peak %s%sdB%s  rms %s%sdB%s' \
             "$LBL" "$dur" "$R" "$LBL" "$peak" "$R" "$LBL" "$rms" "$R")"
    if silent "$peak"; then
        info "  SILENT: try Mic check, or gain 210" \
             "  ${WARN}SILENT${R}${DIM}: try Mic check, or gain 210${R}"
    fi
    bbot
}

do_play() {
    local f="${1:-}" fn hint
    have aplay || { echo "aplay not installed"; return 1; }
    if [ -n "$f" ]; then
        resolve "$f" || { echo "no recording: $f"; return 1; }
        f="$RES"
    else
        pick 'play which?' || return 1
        f="${RECS[$PICK]}"
    fi
    fn="$(basename "$f")"; fn=${fn:0:44}
    if [ -t 0 ]; then hint="any key to stop"; else hint="playing"; fi

    hdr "PLAYBACK" audio
    info "  -> $fn" "  ${DIM}->${R} ${LBL}$fn${R}"
    TICK_DRAWN=0; tick 0 "$hint"
    run_timed "$hint" aplay -q -D default "$f"
    bbot
}

do_delete() {
    local f="${1:-}" n
    if [ -n "$f" ]; then
        resolve "$f" || { echo "no recording: $f"; return 1; }
        f="$RES"
    else
        pick 'delete which?' || return 1
        f="${RECS[$PICK]}"
    fi
    n="$(basename "$f" .wav)"; n=${n:0:36}
    if ask "Delete $n ?"; then
        rm -f "$f" && echo "deleted $n"
    else
        echo "kept $n"
    fi
}

do_list() {
    map_recs
    if [ "${#RECS[@]}" -eq 0 ]; then echo "none in $DIR"; return 0; fi
    local f i=0 dur peak rms n
    for f in "${RECS[@]}"; do
        i=$((i+1))
        set -- $(level "$f"); dur="$1"; peak="$2"; rms="$3"
        n="$(basename "$f" .wav)"
        printf ' %2d %-26.26s %5ss %6sdB\n' "$i" "$n" "$dur" "$peak"
    done
    echo "dir: ${DIR:0:48}"
}

# Record a short probe and report whether the mic actually produced signal.
do_check() {
    local tmp dur peak rms cardline
    card_ok || { echo "no ES8389 sound card"; return 1; }
    have arecord || { echo "arecord not installed"; return 1; }

    hdr_lite "MIC CHECK"
    # /proc/asound/cards reads " 1 [ES8389Audio    ]: cardputerzero-a - ES8389-Audio",
    # which is 51 columns on its own; show the card number and id instead of
    # truncating the line mid-word.
    cardline=$(grep ES8389 "$CARDS" 2>/dev/null | head -1 \
        | sed -n 's/^ *\([0-9]*\) *\[\([^]]*\)\].*/card \1  [\2]/p' \
        | sed 's/  *\]/]/')
    [ -n "$cardline" ] || cardline="ES8389 present"
    info "  $cardline" "  ${LBL}$cardline${R}"
    ctlrow "ADC MUX"     "$(ctlval 'ADC MUX')" "Mic Jack" "$(ctlval 'Mic Jack')"
    ctlrow "ADCL"        "$(ctlval 'ADCL')"    "ADCL PGA" "$(ctlval 'ADCL PGA')"
    ctlrow "PGAL Select" "$(ctlval 'PGAL Select')"
    ctlrow "PGAR Select" "$(ctlval 'PGAR Select')"

    tmp=$(mktemp /tmp/cz-micprobe-XXXXXX.wav) || return 1
    setup_mic
    info "  probing ${PROBE_SEC}s - speak now" \
         "  ${DIM}probing ${PROBE_SEC}s - speak now${R}"
    arecord -q -D "$CAPDEV" -f "$FMT" -c "$CH" -r "$RATE" -d "$PROBE_SEC" "$tmp" < /dev/null

    set -- $(level "$tmp"); dur="$1"; peak="$2"; rms="$3"
    rm -f "$tmp"
    info "$(printf '  %ss peak %sdB rms %sdB' "$dur" "$peak" "$rms")" \
         "$(printf '  %s%ss%s peak %s%sdB%s rms %s%sdB%s' \
             "$LBL" "$dur" "$R" "$LBL" "$peak" "$R" "$LBL" "$rms" "$R")"
    if silent "$peak"; then
        info "  SILENT: check Mic Jack / ADC MUX" \
             "  ${BAD}SILENT${R}${DIM}: check Mic Jack / ADC MUX${R}"
        info "  then try: cz-record gain 210" \
             "  ${DIM}then try: cz-record gain 210${R}"
        bbot
        return 4
    fi
    info "  mic is picking up signal" "  ${OK}mic is picking up signal${R}"
    bbot
}

do_gain() {
    local g="${1:?usage: cz-record gain <0-255>  (191 = 0dB)}"
    [[ "$g" =~ ^[0-9]+$ ]] && [ "$g" -le 255 ] || { echo "gain must be 0-255"; return 1; }
    GAIN="$g"
    amixer -c "$CARD" sset 'ADCL' "$GAIN" >/dev/null 2>&1 \
        || { echo "no ADCL capture control"; return 1; }
    amixer -c "$CARD" sset 'ADCR' "$GAIN" >/dev/null 2>&1
    printf 'capture volume = %s (%s dB)\n' "$GAIN" \
        "$(awk -v g="$GAIN" 'BEGIN{printf "%.1f", -95.5 + g*0.5}')"
    echo 'persist with: Audio menu -> Save levels'
}

# pick <prompt> -> PICK (index into RECS). Boxed rows cost screen space, so the
# window is 7 entries; anything older shows as a count and is reachable from
# `cz-record list`/`play <name>`.
pick() {
    map_recs
    [ "${#RECS[@]}" -gt 0 ] || { echo "no recordings in $DIR"; return 1; }
    local i=0 f bn show=7
    while :; do
        hdr_lite "RECORDINGS"
        i=0
        for f in "${RECS[@]}"; do
            [ "$i" -ge "$show" ] && break
            i=$((i+1))
            bn="$(basename "$f" .wav)"; bn=${bn:0:45}
            row1 "$i" "$bn"
        done
        [ "${#RECS[@]}" -gt "$show" ] \
            && info "  ...and $(( ${#RECS[@]} - show )) older" \
                    "  ${DIM}...and $(( ${#RECS[@]} - show )) older${R}"
        row1 0 "Back"
        info "  $1" "  ${DIM}$1${R}"
        bbot
        # || return: a closed or erroring stdin would otherwise redraw forever.
        read -r -n1 -s k || return 1
        [ "$k" = 0 ] && return 1
        [[ "$k" =~ ^[1-9]$ ]] && [ "$k" -le "$i" ] && { PICK=$((k-1)); return 0; }
    done
}

do_menu() {
    local k n mic
    while :; do
        map_recs
        mic=$(card_ok && echo ok || echo absent)
        hdr "RECORDER" audio
        info "$(printf '  %d saved   mic %s' "${#RECS[@]}" "$mic")" \
             "$(printf '  %s%d saved%s   %smic %s%s' "$LBL" "${#RECS[@]}" "$R" "$DIM" "$mic" "$R")"
        info "  ${DIR:0:47}" "  ${DIM}${DIR:0:47}${R}"
        row1 1 "Record"
        row1 2 "Play"
        row1 3 "Delete"
        row1 4 "Mic check"
        row1 0 "Back"
        bbot
        read -r -n1 -s k || return
        case "$k" in
          1) hdr_lite "NEW RECORDING"
             info "  blank = REC-<timestamp>" "  ${DIM}blank = REC-<timestamp>${R}"
             bbot
             printf '\e[?25h  > '
             read -r n
             do_record "$n"; pause ;;
          2) do_play;   pause ;;
          3) do_delete; pause ;;
          4) do_check;  pause ;;
          0) return ;;
        esac
    done
}

case "${1:-}" in
  rec)   do_record "${2:-}" "${3:-}" ;;
  play)  do_play   "${2:-}" ;;
  del)   do_delete "${2:-}" ;;
  rm)    do_delete "${2:-}" ;;
  list)  do_list ;;
  ls)    do_list ;;
  check) do_check ;;
  gain)  do_gain "${2:-}" ;;
  '')    do_menu ;;
  *)     echo 'usage: cz-record <command>'
         echo '  rec [name] [s] record a voice memo'
         echo '  play <n|name>  play a recording'
         echo '  del  <n|name>  delete a recording'
         echo '  list           list recordings'
         echo '  check          test the mic'
         echo '  gain <0-255>   set capture gain'
         exit 1 ;;
esac
