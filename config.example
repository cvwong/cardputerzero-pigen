IMG_NAME='cardputerzero-v5-console'
RELEASE='trixie'
DEPLOY_COMPRESSION='xz'
COMPRESSION_LEVEL=6
TARGET_HOSTNAME='cardputer'
LOCALE_DEFAULT='en_US.UTF-8'
KEYBOARD_KEYMAP='us'
KEYBOARD_LAYOUT='English (US)'
TIMEZONE_DEFAULT='Asia/Kuala_Lumpur'
FIRST_USER_NAME='pi'
FIRST_USER_PASS=
DISABLE_FIRST_BOOT_USER_RENAME=0
ENABLE_SSH=1
WPA_COUNTRY='MY'
ENABLE_CLOUD_INIT=0

# Resolver written into the build chroot's /etc/resolv.conf so apt can resolve
# during the build. Defaults to 1.1.1.1 (stage0/00-configure-apt/00-run.sh).
# Set a machine-local resolver in your own `config`, which is gitignored --
# this file is published, so do not put a private address here.
#BUILD_NAMESERVER='1.1.1.1'
